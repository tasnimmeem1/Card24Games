<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.payingcards.CardController"
      fx:id="gameRoot"
      alignment="CENTER"
      spacing="14"
      styleClass="game-root">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Card 24 Game" styleClass="title"/>

    <Label text="Use all four card values exactly once to make 24."
           styleClass="instructions"/>

    <HBox alignment="CENTER" spacing="18">
        <StackPane styleClass="card-background">
            <ImageView fx:id="card1"
                       fitWidth="105" fitHeight="155"
                       preserveRatio="true"/>
        </StackPane>

        <StackPane styleClass="card-background">
            <ImageView fx:id="card2"
                       fitWidth="105" fitHeight="155"
                       preserveRatio="true"/>
        </StackPane>

        <StackPane styleClass="card-background">
            <ImageView fx:id="card3"
                       fitWidth="105" fitHeight="155"
                       preserveRatio="true"/>
        </StackPane>

        <StackPane styleClass="card-background">
            <ImageView fx:id="card4"
                       fitWidth="105" fitHeight="155"
                       preserveRatio="true"/>
        </StackPane>
    </HBox>

    <Label fx:id="valuesLabel" styleClass="values"/>

    <Label text="Ace = 1   |   Jack = 11   |   Queen = 12   |   King = 13"
           styleClass="instructions"/>

    <HBox alignment="CENTER" spacing="12">
        <Label text="Expression:" styleClass="instructions"/>

        <TextField fx:id="expressionField"
                   prefWidth="340"
                   promptText="Enter numbers, +, -, *, /, and parentheses"
                   onAction="#verifyExpression"/>
    </HBox>

    <HBox alignment="CENTER" spacing="20">
        <Button text="✓ Verify"
                onAction="#verifyExpression"
                styleClass="verify-button"/>

        <Button text="↻ Refresh"
                onAction="#refreshCards"
                styleClass="refresh-button"/>

        <Button text="Solve"
                onAction="#solveCards"
                styleClass="solve-button"/>

        <Button text="▧ Background"
                onAction="#changeBackground"
                styleClass="background-button"/>
    </HBox>

</VBox>